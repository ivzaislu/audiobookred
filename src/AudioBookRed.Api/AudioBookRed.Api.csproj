<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Version>0.23.0</Version>
    <Product>AudioBookRed</Product>
    <Description>Агрегатор метаданных аудиокниг с фасетным поиском и очередями источников.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Npgsql" Version="9.0.5" />
    <PackageReference Include="AngleSharp" Version="1.7.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="9.0.18" />
  </ItemGroup>
</Project>
