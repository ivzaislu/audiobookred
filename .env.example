# AudioBookRed
# Скопируйте файл в .env и замените значения change-me перед первым запуском.

API_KEY=change-me
DB_PASSWORD=change-me
AUDIOBOOKRED_PORT=9117

# RuTracker: прямое подключение.
RUTRACKER_BASE_URL=https://rutracker.org
RUTRACKER_USERNAME=
RUTRACKER_PASSWORD=
RUTRACKER_FORUM_ID=2388

# RuTracker: необязательный Worker/alias.
RUTRACKER_ALIAS_URL=
RUTRACKER_ALIAS_TOKEN=

# RuTracker: необязательный HTTP/SOCKS proxy.
RUTRACKER_PROXY_URL=
RUTRACKER_PROXY_USERNAME=
RUTRACKER_PROXY_PASSWORD=

# Сеть и срок жизни сессии.
RUTRACKER_NETWORK_TIMEOUT_SECONDS=45
RUTRACKER_SESSION_HOURS=168

# Atom-импорт по умолчанию отключён.
RUTRACKER_ATOM_ENABLED=false
RUTRACKER_ATOM_BASE_URL=https://feed.rutracker.cc
RUTRACKER_ATOM_FORUM_IDS=2388
RUTRACKER_ATOM_INTERVAL_MINUTES=15
RUTRACKER_ATOM_MAX_ENTRIES=50

# Фоновое получение magnet по умолчанию отключено.
RUTRACKER_MAGNET_ENABLED=false
RUTRACKER_MAGNET_INTERVAL_MINUTES=10
RUTRACKER_MAGNET_BATCH_SIZE=20
RUTRACKER_MAGNET_DELAY_MS=2000
RUTRACKER_MAGNET_MAX_ATTEMPTS=5
RUTRACKER_MAGNET_RETRY_MINUTES=60
