# AudioBookRed
# Скопируйте файл в .env и замените значения change-me перед первым запуском.

API_KEY=change-me
DB_PASSWORD=change-me

# Новые установки по умолчанию публикуют API только на loopback.
# Существующий .env при обновлении не изменяется. Для намеренного прямого
# доступа по сети задайте 0.0.0.0 и ограничьте порт firewall.
AUDIOBOOKRED_BIND_ADDRESS=127.0.0.1
AUDIOBOOKRED_PORT=9117

# Database startup and one-time migration limits.
DB_MIGRATION_TIMEOUT_SECONDS=600
AUDIOBOOKRED_STARTUP_TIMEOUT_SECONDS=900

# RuTracker: прямое подключение.
RUTRACKER_BASE_URL=https://rutracker.org
RUTRACKER_USERNAME=
RUTRACKER_PASSWORD=
RUTRACKER_FORUM_ID=2388

# RuTracker: необязательный Worker/alias.
RUTRACKER_ALIAS_URL=
RUTRACKER_ALIAS_TOKEN=

# RuTracker: необязательный HTTP/SOCKS proxy.
RUTRACKER_PROXY_URL=
RUTRACKER_PROXY_USERNAME=
RUTRACKER_PROXY_PASSWORD=

# Сеть и срок жизни сессии.
RUTRACKER_NETWORK_TIMEOUT_SECONDS=45
RUTRACKER_SESSION_HOURS=168

# рабочего маршрута RuTracker/Worker.
# Неизменённые topic_id пропускаются по постоянному fingerprint в PostgreSQL.
# Только новые или действительно изменившиеся темы ставятся в source_topic_jobs;

# Legacy magnet worker не используется: основной queue worker получает magnet
# только для новых/изменившихся source_topic_jobs. Оставьте false.
RUTRACKER_MAGNET_ENABLED=false
RUTRACKER_MAGNET_INTERVAL_MINUTES=10
RUTRACKER_MAGNET_BATCH_SIZE=20
RUTRACKER_MAGNET_DELAY_MS=2000
RUTRACKER_MAGNET_MAX_ATTEMPTS=5
RUTRACKER_MAGNET_RETRY_MINUTES=60

# Rutor: публичные зеркала, перебираются слева направо.
# Runtime-источник rutor создаётся выключенным; включите его через CLI после update.
RUTOR_BASE_URLS=https://rutor.info,https://rutor.is,https://tracker.rutor.is
RUTOR_TIMEOUT_SECONDS=45
